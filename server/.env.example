# Ortam: "development" ya da "production". Boş ya da başka bir değerse sunucu açılmaz.
# production'da eksik/güvensiz ayar varsa sunucu sebebini yazıp kapanır (src/startupChecks.js).
NODE_ENV=development

DB_HOST=127.0.0.1
DB_PORT=5432
# Uygulamanın rolü. Üretimde süper kullanıcı OLAMAZ: db/roles/app-role.sql ile en az yetkili rol oluştur.
DB_USER=studio_user
DB_PASSWORD=change_me
DB_NAME=studio_booking
PORT=3000

# Tablo sahibi rol: migration'lar (npm run migrate) bununla çalışır. Boşsa DB_USER kullanılır (geliştirme).
DB_OWNER_USER=
DB_OWNER_PASSWORD=

# Stüdyo marka dosyalarının (logo vb.) durduğu klasör; repo dışında tutulur. Boşsa /brand sunulmaz.
# Klasördeki HER dosya herkese açıktır: oraya sadece sitede görünecek dosyaları koy.
BRAND_DIR=

# --- Sadece üretim ---
# Uygulama HTTPS sağlayan bir proxy'nin (Caddy/Nginx) arkasında çalışır. Proxy aynı makinedeyse: loopback
TRUST_PROXY=
# Derlenmiş istemci (cd client && npm run build). Site ve API aynı adresten sunulur.
CLIENT_DIR=
