# Ortam: "development" ya da "production". Boş ya da başka bir değerse sunucu açılmaz.
# production'da eksik/güvensiz ayar varsa sunucu sebebini yazıp kapanır (src/startupChecks.js).
NODE_ENV=development

DB_HOST=127.0.0.1
DB_PORT=5432
# Uygulamanın rolü. Üretimde süper kullanıcı ya da tabloların sahibi OLAMAZ: db/roles/app-role.sql ile en az yetkili rol oluştur.
DB_USER=studio_user
DB_PASSWORD=change_me
DB_NAME=studio_booking
PORT=3000
# Dinlenen adres. Boşsa 127.0.0.1: yalnızca bu makineden (önündeki proxy'den) bağlanılır.
# Platform 0.0.0.0 isterse yaz, ama portun yalnızca platformun proxy'sine açık olduğundan emin ol.
HOST=

# Tablo sahibi rol: migration'lar (npm run migrate) bununla çalışır. Boşsa DB_USER kullanılır (geliştirme).
DB_OWNER_USER=
DB_OWNER_PASSWORD=

# Ürünün ana alan adı. Her stüdyo kendi alt alan adından açılır: <slug>.BASE_DOMAIN (ör. demo.localhost:5173).
# Geliştirmede: localhost. Üretimde ürünün alan adı. Boşsa sunucu açılmaz.
BASE_DOMAIN=localhost

# Stüdyo marka dosyalarının (logo, site.json, theme.css) durduğu klasör; repo dışında tutulur. Boşsa /brand sunulmaz.
# Her stüdyonun kendi alt klasörü var: BRAND_DIR/<slug>/ (ör. BRAND_DIR/demo/logo.png, BRAND_DIR/demo/site.json).
# Klasördeki HER dosya herkese açıktır: oraya sadece sitede görünecek dosyaları koy.
BRAND_DIR=

# --- Sadece üretim ---
# Uygulama HTTPS sağlayan bir proxy'nin (Caddy/Nginx) arkasında çalışır. Proxy aynı makinedeyse: loopback
# "true" ya da "*" kabul edilmez (herkese güvenmek demek). Sayı (ör. 1) yalnızca port dışarıya kapalıysa güvenli.
TRUST_PROXY=
# Derlenmiş istemci (cd client && npm run build). Site ve API aynı adresten sunulur.
CLIENT_DIR=
